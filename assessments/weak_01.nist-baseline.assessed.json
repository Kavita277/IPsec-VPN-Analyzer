  "findings": [
    {
      "finding_id": "IPSEC-DH-001",
      "key": "IPSEC-DH-001|negotiated|dh_group|MODP-1024",
      "title": "Forbidden Diffie-Hellman group",
      "severity": "High",
      "category": "algorithm",
      "scope": "negotiated",
      "session_id": "vpn_c0a15c9a873db101",
      "rule_version": "1.0",
      "policy_id": "nist-baseline",
      "evidence": {
        "parameter": "dh_group",
        "observed": "MODP-1024",
        "expected": "One of: MODP-2048, MODP-3072, MODP-4096, MODP-6144, MODP-8192, ECP-256, ECP-384, ECP-521, Curve25519, Curve448",
        "items": [
          {
            "packet": 2,
            "field": "isakmp.tf.id.dh",
            "value": "MODP-1024",
            "session_id": "vpn_c0a15c9a873db101"
          }
        ]
      },
      "why_it_matters": "MODP groups of 1536 bits or fewer give well under 112 bits of security. 1024-bit groups are within reach of well-resourced attackers through precomputation against common primes (the Logjam attack), which can expose the session keys, and RFC 8247 advises against them.",
      "remediation": "Use a 2048-bit or larger MODP group, or an elliptic-curve group, in the IKE proposal on both peers. A proposal that satisfies policy 'nist-baseline': AES-256-CBC / HMAC-SHA2-256 / MODP-3072 (strongSwan swanctl.conf: proposals = aes256-sha256-modp3072).",
      "standards": [
        "RFC 8247",
        "NIST SP 800-57 Part 1 Rev.5",
        "NIST SP 800-131A Rev.2"
      ]
    },
    {
      "finding_id": "IPSEC-INT-002",
      "key": "IPSEC-INT-002|negotiated|integrity|HMAC-SHA1",
      "title": "Deprecated integrity algorithm",
      "severity": "Low",
      "category": "algorithm",
      "scope": "negotiated",
      "session_id": "vpn_c0a15c9a873db101",
      "rule_version": "1.0",
      "policy_id": "nist-baseline",
      "evidence": {
        "parameter": "integrity",
        "observed": "HMAC-SHA1",
        "expected": "One of: HMAC-SHA2-256, HMAC-SHA2-384, HMAC-SHA2-512",
        "items": [
          {
            "packet": 2,
            "field": "isakmp.tf.id.integ",
            "value": "HMAC-SHA1",
            "session_id": "vpn_c0a15c9a873db101"
          }
        ]
      },
      "why_it_matters": "HMAC-SHA1 is still sound as a MAC, since collision attacks on SHA-1 do not apply to the HMAC construction. SHA-1 is deprecated across NIST guidance, though, and current IPsec profiles prefer the SHA-2 family.",
      "remediation": "Move to HMAC-SHA2-256 or stronger on both peers. A proposal that satisfies policy 'nist-baseline': AES-256-CBC / HMAC-SHA2-256 / MODP-3072 (strongSwan swanctl.conf: proposals = aes256-sha256-modp3072).",
      "standards": [
        "NIST SP 800-131A Rev.2",
        "RFC 8247"
      ]
    }
  ],
