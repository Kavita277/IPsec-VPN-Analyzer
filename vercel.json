{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "app": {
      "root": ".",
      "entrypoint": "backend.app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "ai/**,analysis/**,analyzer/**,assessment/**,backend/**,docs/schema/**",
      "maxDuration": 30
    },
    "backend/**/*.py": {
      "includeFiles": "ai/**,analysis/**,analyzer/**,assessment/**,backend/**,docs/schema/**",
      "maxDuration": 30
    }
  }
}
